{
  "expo": {
    "name": "MaisBarato",
    "slug": "maisbarato",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.josivantarcio.maisbarato"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.josivantarcio.maisbarato"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "O MaisBarato usa a câmera para ler o código de barras dos produtos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O MaisBarato usa sua localização para mostrar os mercados perto de você e saber em qual loja você está registrando o preço.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O MaisBarato usa a câmera para fotografar produtos que ainda não têm foto.",
          "photosPermission": false
        }
      ]
    ]
  }
}
